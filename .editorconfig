# Shared editor settings, see https://editorconfig.org
# Python formatting itself is owned by black/isort (pyproject.toml, .isort.cfg).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 88

[*.baml]
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
# trailing double spaces are hard line breaks in Markdown
trim_trailing_whitespace = false
