#!/usr/bin/env bash
# Runs the hooks in .pre-commit-config.yaml on the staged files before committing.
# Install with `make install-hooks`; skip once with `git commit --no-verify`.
# (`pre-commit install` refuses to run while core.hooksPath is set, hence this wrapper.)
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

exec poetry run pre-commit run --hook-stage pre-commit
